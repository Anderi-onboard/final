# Security headers apply to every response and come first so a later, more
# specific block cannot drop them.
#
# The CSP is deliberately strict on where CODE may come from: script-src 'self'
# means an injected <script src> pointing anywhere else is refused by the
# browser even if it somehow reaches the page. 'unsafe-inline' is present
# because the site has inline <script> blocks (the build tag, page bootstraps);
# removing it needs those hoisted into files first — worth doing, not silently
# pretended here. connect-src is limited to same origin: the front-end only
# ever talks to /api/*, and the OpenRouter key lives on the server, so nothing
# in a browser has any business opening a connection elsewhere.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

# Cloudflare Pages response headers.
#
# Code and stylesheets must revalidate on every load (cheap 304 when unchanged)
# so a fresh deploy shows up immediately instead of being served stale from the
# browser's cache. Without this, Pages' default `max-age=14400` pins JS/CSS in
# the browser for 4 hours, which made a new mountain-range.js / chat-app.js keep
# rendering the previous version until the cache expired.
/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate

# Fonts are content-stable (their contents never change under the same name),
# so they can stay cached for a year — no revalidation cost on repeat views.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
