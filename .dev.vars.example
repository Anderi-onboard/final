# Copy to .dev.vars for local `wrangler pages dev`. NEVER commit the real key.
# In production these go in Cloudflare Pages → Settings → Environment variables.

# Required — your OpenRouter API key (the proxy calls Claude models through
# OpenRouter, not Anthropic directly).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional model overrides (defaults shown, as OpenRouter model slugs). The
# proxy routes by product/role:
#   stria  → Opus 5          sortis → Opus 5        router/qc → Haiku 4.5
# STRIA_MODEL=anthropic/claude-opus-5
# SORTIS_MODEL=anthropic/claude-opus-5
# UTILITY_MODEL=anthropic/claude-haiku-4.5

# Optional cap on response length (clamped 256–8192).
# CLAUDE_MAX_TOKENS=1024

# ── Accounts ──────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth (optional). Without these, the app still has real persisted
# accounts via email/dev sign-in; "Continue with Google" just stays inactive.
# Authorized redirect URI in Google Cloud console:
#   https://YOUR-DOMAIN/api/auth/google/callback
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx

# ── Creem payments (leave unset to keep the demo fallback) ──────────────────
# Key prefix picks the API base automatically (creem_test_ → test-api.creem.io)
CREEM_API_KEY=creem_test_xxxxxxxxxxxxxxxx
CREEM_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
CREEM_PRODUCT_PROMONTHLY=prod_xxxxxxxx
CREEM_PRODUCT_PROANNUAL=prod_xxxxxxxx
CREEM_PRODUCT_PREMIUMMONTHLY=prod_xxxxxxxx
CREEM_PRODUCT_PREMIUMANNUAL=prod_xxxxxxxx
CREEM_PRODUCT_PACK7500=prod_xxxxxxxx
CREEM_PRODUCT_PACK15000=prod_xxxxxxxx
CREEM_PRODUCT_PACK30000=prod_xxxxxxxx
CREEM_PRODUCT_PACK75000=prod_xxxxxxxx
