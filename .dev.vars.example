# 本地跑整站 —— 复制成 `.dev.vars`(它在 .gitignore 里,不会提交)
#
# ⭐ 和线上唯一的差别就是下面这两行:端点和模型名。
#    计费闸、危机闸、免费额度、流式 SSE、D1、前端 —— 全部走线上那条路,代码一行不改。

# ── ① 上游端点 ──────────────────────────────────────────────────────────────
# 不设 = 线上(OpenRouter)。设了 = 本地。
#   Ollama       ollama serve                    → http://localhost:11434/v1
#   LM Studio    开 Local Server                 → http://localhost:1234/v1
#   llama.cpp    llama-server -m x.gguf          → http://localhost:8080/v1
#   vLLM         vllm serve …                    → http://localhost:8000/v1
#
# ⚠️ wrangler 跑在 workerd 里,`localhost` 指的是它自己。
#    macOS/Windows 的 Docker 环境用 host.docker.internal;裸机上 localhost 就行。
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=local

# ── ② 模型名 ────────────────────────────────────────────────────────────────
# 线上是 anthropic/claude-opus-5 那套;本地填你 `ollama list` 里的名字。
# 分站配:M1/M2/M3 走 UTILITY_MODEL(小的够用),M4 走 SORTIS_MODEL。
SORTIS_MODEL=qwen2.5:32b
STRIA_MODEL=qwen2.5:32b
UTILITY_MODEL=qwen2.5:7b

# ── ③ 把模型开回来 ──────────────────────────────────────────────────────────
# 不设这个就是离线模式(返回罐头解读、不计费)—— 那是线上的默认,不是 bug。
LIVE_MODEL=on

# ── ④ 会话 ──────────────────────────────────────────────────────────────────
# 没有它谁都登录不了,于是也没人能起卦(计费闸要一个账号)。
# 本地随便一串就行;线上是 Pages 里的密钥。
SESSION_SECRET=local-dev-only-not-a-secret

# ── 可选 ────────────────────────────────────────────────────────────────────
# CLAUDE_MAX_TOKENS=12000
# CLAUDE_THINKING=on          # 只对 OpenRouter 有意义,本地端点会忽略
# OPENROUTER_API_KEY=sk-or-…  # 想在本地打线上模型时才填(会花钱)
