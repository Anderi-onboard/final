# Copy to .env (git-ignored) and fill in. Read by scripts/ask.mjs at start.
#
# Anthropic API, your own key and quota (used when ANTHROPIC_API_KEY is set and
# no OPENROUTER_API_KEY is set, or with --anthropic):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional: a different model for each stage (understand / claim / synth).
ANTHROPIC_MODEL_UNDERSTAND=
ANTHROPIC_MODEL_CLAIM=
ANTHROPIC_MODEL_SYNTH=

# OpenRouter (used with --real):
OPENROUTER_API_KEY=
LIUYAO_MODEL_UNDERSTAND=
LIUYAO_MODEL_CLAIM=
LIUYAO_MODEL_SYNTH=
